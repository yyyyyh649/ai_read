# AI API 配置（OpenAI 兼容接口）
# 支持 Hermes step3.7 / Agnes 等任何 OpenAI 兼容 API
AI_API_BASE_URL=http://140.245.45.176:8000/v1
AI_API_KEY=your-api-key-here
AI_MODEL_NAME=step-3.7

# 备用模型（用于翻译等低成本任务）
# 留空则回退到主模型配置
AI_API_BASE_URL_FAST=
AI_API_KEY_FAST=
AI_MODEL_NAME_FAST=agnes

# 服务器配置
HOST=0.0.0.0
PORT=8000

# PDF 最大文件大小（MB）
MAX_UPLOAD_SIZE_MB=50

# 是否启用热重载（生产环境务必设为 false）
UVICORN_RELOAD=false
