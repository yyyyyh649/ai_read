# AI API 配置（OpenAI 兼容接口）
# 支持 Hermes step3.7 / Agnes / OpenAI / DeepSeek / 任何 OpenAI 兼容 API
AI_API_BASE_URL=https://api.example.com/v1
AI_API_KEY=your-api-key-here
AI_MODEL_NAME=gpt-4o-mini

# 辅助模型（用于翻译等低成本任务）
# 留空则回退到主模型配置
AI_API_BASE_URL_FAST=
AI_API_KEY_FAST=
AI_MODEL_NAME_FAST=

# 服务器配置
HOST=0.0.0.0
PORT=8000

# PDF 最大文件大小（MB）
MAX_UPLOAD_SIZE_MB=50

# 是否启用热重载（生产环境务必设为 false）
UVICORN_RELOAD=false

# ─── 安全相关（生产环境强烈建议配置） ───

# 管理员令牌：配置后，上传/删除/修改 API 配置等敏感接口需要请求头
#   Authorization: Bearer <ADMIN_TOKEN>
# 留空则不启用鉴权（仅本地开发使用）
ADMIN_TOKEN=

# 允许的 CORS 来源（逗号分隔）
# 本地开发：http://localhost:8000,http://127.0.0.1:8000
# 生产环境请改成你自己的域名，如：https://your-domain.com
ALLOWED_ORIGINS=*
